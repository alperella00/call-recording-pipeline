# Copy to .env and fill in. Never commit .env.

# Speech-to-text (required to process recordings)
ELEVENLABS_API_KEY=

# Meeting/complaint extraction (optional). Without it, a rule-based extractor is used.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# Database passwords (optional; local development defaults are used when unset)
# POSTGRES_PASSWORD=
# APP_API_DB_PASSWORD=
# APP_WORKER_DB_PASSWORD=

# CRM mock failure mode (1 = failures on)
# CHAOS=1
